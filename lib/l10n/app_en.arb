  "faqQuestion1": "Why does Doc View need All files access?",
  "@faqQuestion1": {
    "description": "FAQ question 1 regarding storage permissions"
  },
  "faqAnswer1": "Doc View requires All files access (MANAGE_EXTERNAL_STORAGE) on Android 11+ to discover and index supported documents (PDF, Word, Excel, PowerPoint, Text, and Images) stored in shared folders such as Downloads and Documents.\n\nWithout this permission, Android restricts file access to the app's private internal folder, preventing Doc View from browsing or opening files located across your device.",
  "@faqAnswer1": {
    "description": "FAQ answer 1 regarding storage permissions"
  },
  "faqQuestion2": "Why doesn't it scan my whole iPhone?",
  "@faqQuestion2": {
    "description": "FAQ question 2 regarding iOS sandboxing"
  },
  "faqAnswer2": "iOS uses strict app sandboxing to safeguard device privacy. Apps can only access documents explicitly saved inside the Files app or shared via the system Share Sheet.\n\nTo view files on iOS, import them into the Doc View folder in the native Files app or use the Import files option in Settings.",
  "@faqAnswer2": {
    "description": "FAQ answer 2 regarding iOS sandboxing"
  },
  "faqQuestion3": "Where are the PDFs I create saved?",
  "@faqQuestion3": {
    "description": "FAQ question 3 regarding generated file storage location"
  },
  "faqAnswer3": "Files you import or generate (such as converted PDFs, merged documents, or split pages) are saved securely in your device storage under DocView/Created or private app storage. You can view them anytime in the Created by you section on the Tools tab.",
  "@faqAnswer3": {
    "description": "FAQ answer 3 regarding generated file storage location"
  },
  "faqQuestion4": "Why does my Word file look different?",
  "@faqQuestion4": {
    "description": "FAQ question 4 regarding offline office rendering"
  },
  "faqAnswer4": "Doc View renders files directly on your device using local offline parsers without sending private data to cloud converters. Complex formatting or custom shapes render with native offline approximations.",
  "@faqAnswer4": {
    "description": "FAQ answer 4 regarding offline office rendering"
  },
  "faqQuestion5": "Can I open password-protected files?",
  "@faqQuestion5": {
    "description": "FAQ question 5 regarding encrypted PDF support"
  },
  "faqAnswer5": "Yes, Doc View supports opening password-protected PDF documents. When opening an encrypted PDF, enter the password in the dialog to decrypt and view the document on your device.",
  "@faqAnswer5": {
    "description": "FAQ answer 5 regarding encrypted PDF support"
  },
  "faqQuestion6": "Is my data uploaded anywhere?",
  "@faqQuestion6": {
    "description": "FAQ question 6 regarding privacy and data policy"
  },
  "faqAnswer6": "Your documents never leave your device. Doc View opens, converts and stores files locally. The app shows ads served by Google AdMob, which can use limited device data as described in our Privacy Policy.",
  "@faqAnswer6": {
    "description": "FAQ answer 6 regarding privacy and data policy"
  },
