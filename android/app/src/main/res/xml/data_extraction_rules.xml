<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude user signature files from cloud backup -->
        <exclude domain="file" path="signatures.json" />
        <exclude domain="file" path="signatures" />
        <!-- Exclude Recycle Bin from cloud backup -->
        <exclude domain="file" path="recycle_bin" />
        <!-- Exclude local document database -->
        <exclude domain="database" path="docview.db" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude signatures from unencrypted device transfer -->
        <exclude domain="file" path="signatures.json" />
        <exclude domain="file" path="signatures" />
        <!-- Exclude Recycle Bin from device transfer -->
        <exclude domain="file" path="recycle_bin" />
    </device-transfer>
</data-extraction-rules>
